# Local install / runtime artifacts — never commit
node_modules/
dist/
packages/
data/
logs/
deployment.pid
src-tree/
ops/*.log
ops/*.pid
.DS_Store
*.swp
# Secrets — never commit (Aliyun packages basic auth, etc.). Runtime creds
