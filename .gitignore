.env
.env.*
*credentials
*credentials.*
*secret*
*token*
bin/deployment-server
bin/acp-upgrader
# stray binary produced by `go build` (no -o) inside src/
/src/src
outputs/
.gomodcache/
.gocache/
.gopath/
